# DB_URL собирает docker-compose.yml из переменных ниже — вручную не задавать

# Postgres
POSTGRES_USER=jam
POSTGRES_PASSWORD=jam
POSTGRES_DB=jam

# Сервер
API_PORT=8018
RATE_RPS=5
RATE_BURST=20

# Коллектор
JAM_ID=12
MIN_INTERVAL=0.7
SCAN_RANGE=1-350

# Интервалы опроса, сек (0 отключает задачу)
API_EVERY=600
VOTE_EVERY=900
GAMES_EVERY=300
SCAN_EVERY=86400

# Сессия для сбора баллов с vote.php, в git не коммитится
DUSTORE_SESSION=

# Бэкапы БД: интервал (сек) и число хранимых дампов
BACKUP_EVERY=300
BACKUP_KEEP=5
