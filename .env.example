# DB_URL собирает docker-compose.yml из переменных ниже — вручную не задавать

# Postgres
POSTGRES_USER=jam
POSTGRES_PASSWORD=jam
POSTGRES_DB=jam

# Сервер
API_PORT=8018
RATE_RPS=5
RATE_BURST=20

# Коллектор
JAM_ID=12
MIN_INTERVAL=0.7
SCAN_RANGE=1-350

# Интервалы опроса, сек (0 отключает задачу)
API_EVERY=600
VOTE_EVERY=900
GAMES_EVERY=300
SCAN_EVERY=86400

# Авторизация для сбора баллов с vote.php, в git не коммитится.
# Основной способ — логин: коллектор входит сам и обновляет токен (живёт 72 ч).
# Пароль в одинарных кавычках, чтобы compose не трогал «$» и прочее.
DUSTORE_EMAIL=
DUSTORE_PASSWORD=''
# Запасной: строка Cookie целиком из DevTools (Network → vote.php → Request Headers),
# придётся обновлять руками раз в 72 ч. Кавычки обязательны: в строке есть «;».
DUSTORE_COOKIE=""

# Бэкапы БД: интервал (сек) и число хранимых дампов
BACKUP_EVERY=300
BACKUP_KEEP=5
